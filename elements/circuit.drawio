        </mxCell>
        <mxCell id="lg6" value="BOOT (GPIO0) 板载虚线" style="text;html=1;fontSize=11;fontColor=#52229E;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="731" y="748" width="160" height="24" as="geometry" />
        </mxCell>

        <!-- ===== 底部注意事项 ===== -->
        <mxCell id="note" value="" style="rounded=1;arcSize=10;fillColor=#F5F7FA;strokeColor=#B7C3D2;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="40" y="786" width="1130" height="60" as="geometry" />
        </mxCell>
        <mxCell id="note_text" value="注意：OLED 与 PAJ7620U2 并联共用 SDA / SCL（图中十字交叉处无圆点 = 不相连）。若模块没有板载上拉，SDA、SCL 各接 4.7 kΩ 至 3.3V。PAJ7620U2 的 PS 跳线断开时，VL 脚单独接 3.3V；裸蜂鸣器需按器件规格确认 GPIO 驱动能力，必要时加三极管驱动。" style="text;html=1;fontSize=12;fontColor=#444444;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="786" width="1130" height="60" as="geometry" />
        </mxCell>
        <!-- ===== 就近注释：左上 I²C 库说明 ===== -->
        <mxCell id="note_i2c_box" value="" style="rounded=1;arcSize=8;fillColor=#F6F8FA;strokeColor=#B7C3D2;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="40" y="84" width="400" height="130" as="geometry" />
        </mxCell>
        <mxCell id="note_i2c_hdr" value="I²C 开发简化 · 用库 API 代替手工时序" style="text;html=1;fontSize=12;fontStyle=1;fontColor=#1A1A1A;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="52" y="90" width="376" height="18" as="geometry" />
        </mxCell>
        <mxCell id="note_i2c_c1" value="#include &lt;Wire.h&gt;              // I²C 基础库" style="text;html=1;fontFamily=Courier New;fontSize=10;fontColor=#24292F;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="52" y="110" width="376" height="14" as="geometry" />
        </mxCell>
        <mxCell id="note_i2c_c2" value="#include &lt;Adafruit_SSD1306.h&gt;  // OLED 驱动" style="text;html=1;fontFamily=Courier New;fontSize=10;fontColor=#24292F;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="52" y="124" width="376" height="14" as="geometry" />
        </mxCell>
        <mxCell id="note_i2c_c3" value="#include &lt;RevEng_PAJ7620.h&gt;    // 手势传感器" style="text;html=1;fontFamily=Courier New;fontSize=10;fontColor=#24292F;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="52" y="138" width="376" height="14" as="geometry" />
        </mxCell>
        <mxCell id="note_i2c_c4" value="Wire.begin(21, 22);   // SDA=21, SCL=22" style="text;html=1;fontFamily=Courier New;fontSize=10;fontColor=#24292F;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="52" y="152" width="376" height="14" as="geometry" />
        </mxCell>
        <mxCell id="note_i2c_txt" value="若仅用 &lt;Arduino.h&gt;：要严格按 I²C 读写规则，手工查找从设备地址、读写寄存器，非常繁琐；这些库已封装协议细节，只需调用相关 API。" style="text;html=1;fontSize=10;fontColor=#555555;align=left;verticalAlign=middle;spacingLeft=8;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="52" y="168" width="376" height="42" as="geometry" />
        </mxCell>

        <!-- ===== 就近注释：蜂鸣器下方 PWM 说明 ===== -->
        <mxCell id="note_pwm_box" value="" style="rounded=1;arcSize=8;fillColor=#F6F8FA;strokeColor=#B7C3D2;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="920" y="444" width="260" height="112" as="geometry" />
        </mxCell>
        <mxCell id="note_pwm_hdr" value="GPIO5 · PWM 生成与非阻塞蜂鸣" style="text;html=1;fontSize=11;fontStyle=1;fontColor=#994000;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="930" y="450" width="240" height="16" as="geometry" />
        </mxCell>
        <mxCell id="note_pwm_c1" value="ledcSetup(0, 4000, 8);   // 4kHz, 8位" style="text;html=1;fontFamily=Courier New;fontSize=10;fontColor=#24292F;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="930" y="470" width="240" height="14" as="geometry" />
        </mxCell>
        <mxCell id="note_pwm_c2" value="ledcAttachPin(5, 0);     // GPIO5 绑通道" style="text;html=1;fontFamily=Courier New;fontSize=10;fontColor=#24292F;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="930" y="484" width="240" height="14" as="geometry" />
        </mxCell>
        <mxCell id="note_pwm_c3" value="ledcWrite(0, 128);  // 50% 占空比发声" style="text;html=1;fontFamily=Courier New;fontSize=10;fontColor=#24292F;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="930" y="498" width="240" height="14" as="geometry" />
        </mxCell>
        <mxCell id="note_pwm_c4" value="beepEndMs = millis() + durationMs;" style="text;html=1;fontFamily=Courier New;fontSize=10;fontColor=#24292F;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="930" y="512" width="240" height="14" as="geometry" />
        </mxCell>
        <mxCell id="note_pwm_txt" value="loop() 中时间戳轮询：到点 ledcWrite(0, 0) 静音，不阻塞主循环。" style="text;html=1;fontSize=10;fontColor=#555555;align=left;verticalAlign=middle;spacingLeft=8;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="930" y="528" width="240" height="26" as="geometry" />
        </mxCell>

