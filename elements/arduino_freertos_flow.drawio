                <mxCell id="ft_note_t" parent="1" style="text;html=1;fontSize=12;fontStyle=1;fontColor=#7A5B00;align=left;verticalAlign=middle;spacingLeft=12;" value="要点总结" vertex="1">
                    <mxGeometry height="18" width="200" x="40" y="778" as="geometry"/>
