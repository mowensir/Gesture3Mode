                    <mxGeometry height="150" width="420" x="940" y="360" as="geometry"/>
                </mxCell>
                <mxCell id="d2_t" parent="1" style="text;html=1;fontSize=11;fontStyle=1;fontColor=#00614D;align=left;verticalAlign=middle;spacingLeft=10;" value="双核分工（ESP32-D0WD · 两个 CPU 核）" vertex="1">
                    <mxGeometry height="18" width="420" x="940" y="368" as="geometry"/>
                </mxCell>
                <mxCell id="d2_c1" parent="1" style="text;html=1;fontFamily=Courier New;fontSize=10;fontColor=#24292F;align=left;verticalAlign=middle;spacingLeft=12;" value="Core 0 → 蓝牙/WiFi 协议栈" vertex="1">
                    <mxGeometry height="15" width="420" x="940" y="390" as="geometry"/>
                </mxCell>
                <mxCell id="d2_c2" parent="1" style="text;html=1;fontFamily=Courier New;fontSize=10;fontColor=#24292F;align=left;verticalAlign=middle;spacingLeft=12;" value="  BT 控制器 + NimBLE host 任务" vertex="1">
                    <mxGeometry height="15" width="420" x="940" y="405" as="geometry"/>
                </mxCell>
                <mxCell id="d2_c3" parent="1" style="text;html=1;fontFamily=Courier New;fontSize=10;fontColor=#24292F;align=left;verticalAlign=middle;spacingLeft=12;" value="Core 1 → Arduino loopTask" vertex="1">
                    <mxGeometry height="15" width="420" x="940" y="420" as="geometry"/>
                </mxCell>
                <mxCell id="d2_c4" parent="1" style="text;html=1;fontFamily=Courier New;fontSize=10;fontColor=#24292F;align=left;verticalAlign=middle;spacingLeft=12;" value="  你的 setup() / loop() 在这里跑" vertex="1">
                    <mxGeometry height="15" width="420" x="940" y="435" as="geometry"/>
                </mxCell>
                <mxCell id="d2_n" parent="1" style="text;html=1;fontSize=10;fontColor=#555555;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;whiteSpace=wrap;" value="两个核由同一个 FreeRTOS 调度器统一管理：蓝牙收发跑在 Core 0，用户代码跑在 Core 1，几乎互不抢时间。这是 Arduino 框架的默认绑定（loopTask 固定 Core 1、NimBLE host 固定 Core 0），main.cpp 未显式调用绑核 API，无需任何额外代码。" vertex="1">
                    <mxGeometry height="48" width="420" x="940" y="454" as="geometry"/>
                </mxCell>
                <mxCell id="d3_card" parent="1" style="rounded=1;arcSize=8;fillColor=#F7F2FD;strokeColor=#C7ADF2;strokeWidth=1.5;shadow=1;" value="" vertex="1">
                    <mxGeometry height="170" width="420" x="940" y="540" as="geometry"/>
                </mxCell>
                <mxCell id="d3_t" parent="1" style="text;html=1;fontSize=11;fontStyle=1;fontColor=#52229E;align=left;verticalAlign=middle;spacingLeft=10;" value="跨任务共享变量（回调在哪个任务里跑？）" vertex="1">
                    <mxGeometry height="18" width="420" x="940" y="548" as="geometry"/>
                </mxCell>
                <mxCell id="d3_c1" parent="1" style="text;html=1;fontFamily=Courier New;fontSize=10;fontColor=#24292F;align=left;verticalAlign=middle;spacingLeft=12;" value="volatile bool deviceConnected;" vertex="1">
                    <mxGeometry height="15" width="420" x="940" y="570" as="geometry"/>
                </mxCell>
                <mxCell id="d3_c2" parent="1" style="text;html=1;fontFamily=Courier New;fontSize=10;fontColor=#24292F;align=left;verticalAlign=middle;spacingLeft=12;" value="onConnect / onDisconnect 回调" vertex="1">
                    <mxGeometry height="15" width="420" x="940" y="585" as="geometry"/>
                </mxCell>
                <mxCell id="d3_c3" parent="1" style="text;html=1;fontFamily=Courier New;fontSize=10;fontColor=#24292F;align=left;verticalAlign=middle;spacingLeft=12;" value="  → 运行在 BLE 任务（Core 0），不是 loop！" vertex="1">
                    <mxGeometry height="15" width="420" x="940" y="600" as="geometry"/>
                </mxCell>
                <mxCell id="d3_c4" parent="1" style="text;html=1;fontFamily=Courier New;fontSize=10;fontColor=#24292F;align=left;verticalAlign=middle;spacingLeft=12;" value="loop() 任务只读取该标志 → 加 volatile" vertex="1">
                    <mxGeometry height="15" width="420" x="940" y="615" as="geometry"/>
                </mxCell>
                <mxCell id="d3_n" parent="1" style="text;html=1;fontSize=10;fontColor=#555555;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;whiteSpace=wrap;" value="一个任务写、另一个任务读 → 必须 volatile，防止编译器把“重复读取”优化成只读一次；bleRssi 只在 loop 任务里读写，所以不用加。这是 main.cpp 里现成的教学例子。" vertex="1">
                    <mxGeometry height="68" width="420" x="940" y="634" as="geometry"/>
                </mxCell>
                <mxCell id="ft_note" parent="1" style="rounded=1;arcSize=10;fillColor=#FDF9EC;strokeColor=#E5D08A;strokeWidth=1.5;" value="" vertex="1">
                    <mxGeometry height="86" width="1320" x="40" y="770" as="geometry"/>
