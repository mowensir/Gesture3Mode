                <mxCell id="d1_c2" parent="1" style="text;html=1;fontFamily=Courier New;fontSize=10;fontColor=#24292F;align=left;verticalAlign=middle;spacingLeft=12;" value="任务进入“阻塞态”→ CPU 立即让给" vertex="1">
                    <mxGeometry height="15" width="420" x="940" y="215" as="geometry"/>
                </mxCell>
                <mxCell id="d1_c3" parent="1" style="text;html=1;fontFamily=Courier New;fontSize=10;fontColor=#24292F;align=left;verticalAlign=middle;spacingLeft=12;" value="其它就绪任务（BLE 协议栈、系统空闲）" vertex="1">
                    <mxGeometry height="15" width="420" x="940" y="230" as="geometry"/>
                </mxCell>
                <mxCell id="d1_n" parent="1" style="text;html=1;fontSize=10;fontColor=#555555;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;whiteSpace=wrap;" value="loop() 每圈最多等 15ms 就回来干活；若写 delay(5000)，蓝牙提示音、按键响应全都会卡 5 秒——所以本项目全用 millis() 时间戳（beepEndMs / 30ms 防抖 / 2s 刷新），不用长 delay。" vertex="1">
                    <mxGeometry height="76" width="420" x="940" y="248" as="geometry"/>
                </mxCell>
