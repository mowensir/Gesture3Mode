                </mxCell>
                <mxCell id="d1_c1" parent="1" style="text;html=1;fontFamily=Courier New;fontSize=10;fontColor=#24292F;align=left;verticalAlign=middle;spacingLeft=12;" value="delay(ms) ≡ vTaskDelay(ms / tick)" vertex="1">
                    <mxGeometry height="15" width="420" x="940" y="200" as="geometry"/>
