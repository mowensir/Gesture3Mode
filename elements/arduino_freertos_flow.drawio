                <mxCell id="ft_note_1" parent="1" style="text;html=1;fontSize=11;fontColor=#444444;align=left;verticalAlign=middle;spacingLeft=12;whiteSpace=wrap;" value="① setup()/loop() = FreeRTOS 的 loopTask 任务：setup 跑一遍，loop 被 for(;;) 反复调用；② delay() = vTaskDelay，让出 CPU 而不是死等；" vertex="1">
                    <mxGeometry height="24" width="1290" x="52" y="798" as="geometry"/>
                </mxCell>
                <mxCell id="ft_note_2" parent="1" style="text;html=1;fontSize=11;fontColor=#444444;align=left;verticalAlign=middle;spacingLeft=12;whiteSpace=wrap;" value="③ 蓝牙协议栈在 Core 0 的独立任务里，BLE 回调不在 loop() 中执行 → 跨任务标志要 volatile；④ 单任务也能“并发”：像 main.cpp 那样用 millis() 时间戳轮询，每圈 ≤15ms 永不阻塞。" vertex="1">
                    <mxGeometry height="24" width="1290" x="52" y="824" as="geometry"/>
                </mxCell>
