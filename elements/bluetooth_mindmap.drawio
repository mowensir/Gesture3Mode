          <mxGeometry x="1180" y="378" width="390" height="15" as="geometry" />
        </mxCell>
        <mxCell id="r2_c5" value="consumerControl... // 媒体信箱 getInputReport(3);" style="text;html=1;fontFamily=Courier New;fontSize=10;fontColor=#24292F;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="1180" y="394" width="390" height="15" as="geometry" />
        </mxCell>
        <mxCell id="r2_n" value="sendKey() 投进 ID1 信箱 → 主机当键盘按键处理；sendMouse() 投进 ID2 信箱 → 当鼠标位移处理。信箱互不混用，主机不用猜“这包数据是谁的”——这就是一个蓝牙同时当键盘 + 鼠标 + 遥控器的实现方式。Report Map（⑤）提前告诉主机每个信箱的数据格式。" style="text;html=1;fontSize=10;fontColor=#555555;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1180" y="412" width="390" height="80" as="geometry" />
        </mxCell>

