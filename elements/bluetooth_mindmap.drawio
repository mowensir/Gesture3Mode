        <mxCell id="r3_c3" value="keyboardInputReport-&gt;notify();   // 推送" style="text;html=1;fontFamily=Courier New;fontSize=10;fontColor=#24292F;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="1180" y="592" width="390" height="15" as="geometry" />
        </mxCell>
        <mxCell id="r3_c4" value="delay(KEY_PRESS_DURATION_MS);  // 20ms" style="text;html=1;fontFamily=Courier New;fontSize=10;fontColor=#24292F;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="1180" y="608" width="390" height="15" as="geometry" />
        </mxCell>
        <mxCell id="r3_c5" value="keyboardInputReport-&gt;setValue(n, 8); // 全0" style="text;html=1;fontFamily=Courier New;fontSize=10;fontColor=#24292F;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="1180" y="624" width="390" height="15" as="geometry" />
        </mxCell>
        <mxCell id="r3_c6" value="keyboardInputReport-&gt;notify();   // 释放" style="text;html=1;fontFamily=Courier New;fontSize=10;fontColor=#24292F;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="1180" y="640" width="390" height="15" as="geometry" />
        </mxCell>
        <mxCell id="r3_n" value="按下 + 释放成对发送，主机才知道“按键结束了”；notify 由从机主动推送、无需主机应答，延迟低又省电。" style="text;html=1;fontSize=10;fontColor=#555555;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1180" y="658" width="390" height="46" as="geometry" />
