          <mxGeometry x="40" y="180" width="390" height="15" as="geometry" />
        </mxCell>
        <mxCell id="l1_c7" value="0x85, 3  // Report ID 3 → 媒体键" style="text;html=1;fontFamily=Courier New;fontSize=10;fontColor=#24292F;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="196" width="390" height="15" as="geometry" />
        </mxCell>
        <mxCell id="l1_c8" value="  {0xE9, 0} 2字节usage = 音量+" style="text;html=1;fontFamily=Courier New;fontSize=10;fontColor=#24292F;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="212" width="390" height="15" as="geometry" />
        </mxCell>
        <mxCell id="l1_n" value="主机收到数据时看它来自哪条特征（ID 1/2/3），再按 Report Map 约定的格式解析：同样是几个字节，ID1 解读成“按了 PageUp”，ID2 解读成“鼠标动了多少”——互不混淆。这就是描述符 0x85（Report ID 标签）的作用。" style="text;html=1;fontSize=10;fontColor=#555555;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="230" width="390" height="56" as="geometry" />
        </mxCell>

        <!-- ===== L2 动作发送函数 ===== -->
        <mxCell id="l2_hdr" value="⑥ 动作发送函数" style="rounded=1;arcSize=40;fillColor=#0E8FA3;strokeColor=#085A68;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#FFFFFF;html=1;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="470" y="399" width="190" height="46" as="geometry" />
        </mxCell>
        <mxCell id="e_l2c" style="edgeStyle=none;rounded=0;html=1;strokeWidth=2;strokeColor=#085A68;endArrow=none;startArrow=none;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="470" y="422" as="sourcePoint" />
            <mxPoint x="430" y="422" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="l2_card" value="" style="rounded=1;arcSize=8;fillColor=#EEF8FA;strokeColor=#8FD0DA;strokeWidth=1.5;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="340" width="390" height="165" as="geometry" />
        </mxCell>
        <mxCell id="l2_t" value="统一封装，模式映射只管调用" style="text;html=1;fontSize=11;fontStyle=1;fontColor=#085A68;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="348" width="390" height="18" as="geometry" />
        </mxCell>
        <mxCell id="l2_c1" value="sendKey(mod, key);             // 键盘" style="text;html=1;fontFamily=Courier New;fontSize=10;fontColor=#24292F;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="370" width="390" height="15" as="geometry" />
        </mxCell>
        <mxCell id="l2_c2" value="sendMouse(dx, dy, wheel, btn); // 鼠标" style="text;html=1;fontFamily=Courier New;fontSize=10;fontColor=#24292F;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="386" width="390" height="15" as="geometry" />
        </mxCell>
        <mxCell id="l2_c3" value="sendConsumer(usage);           // 媒体键" style="text;html=1;fontFamily=Courier New;fontSize=10;fontColor=#24292F;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="402" width="390" height="15" as="geometry" />
        </mxCell>
        <mxCell id="l2_c4" value="repeatConsumer(0x00E9, 3);     // 音量+ x3" style="text;html=1;fontFamily=Courier New;fontSize=10;fontColor=#24292F;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="418" width="390" height="15" as="geometry" />
        </mxCell>
        <mxCell id="l2_c5" value="repeatWheel(1, 5);             // 滚轮 x5" style="text;html=1;fontFamily=Courier New;fontSize=10;fontColor=#24292F;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="434" width="390" height="15" as="geometry" />
        </mxCell>
        <mxCell id="l2_n" value="重复动作间隔 HID_REPEAT_INTERVAL_MS = 25ms；所有发送函数都先检查 deviceConnected，未连接就静默跳过，不会报错。" style="text;html=1;fontSize=10;fontColor=#555555;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="452" width="390" height="46" as="geometry" />
        </mxCell>

        <!-- ===== L3 安全与配对 ===== -->
        <mxCell id="l3_hdr" value="⑦ 安全与配对" style="rounded=1;arcSize=40;fillColor=#D9A400;strokeColor=#7A5B00;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#FFFFFF;html=1;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="470" y="604" width="190" height="46" as="geometry" />
        </mxCell>
        <mxCell id="e_l3c" style="edgeStyle=none;rounded=0;html=1;strokeWidth=2;strokeColor=#7A5B00;endArrow=none;startArrow=none;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="470" y="627" as="sourcePoint" />
            <mxPoint x="430" y="627" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="l3_card" value="" style="rounded=1;arcSize=8;fillColor=#FDF9EC;strokeColor=#E5D08A;strokeWidth=1.5;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="560" width="390" height="135" as="geometry" />
        </mxCell>
        <mxCell id="l3_t" value="配对一次，重连免操作" style="text;html=1;fontSize=11;fontStyle=1;fontColor=#7A5B00;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="568" width="390" height="18" as="geometry" />
        </mxCell>
        <mxCell id="l3_c1" value="NimBLEDevice::setSecurityAuth(" style="text;html=1;fontFamily=Courier New;fontSize=10;fontColor=#24292F;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="590" width="390" height="15" as="geometry" />
        </mxCell>
        <mxCell id="l3_c2" value="    true, false, false);" style="text;html=1;fontFamily=Courier New;fontSize=10;fontColor=#24292F;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="606" width="390" height="15" as="geometry" />
        </mxCell>
        <mxCell id="l3_n" value="三个参数依次 = Bonding(配对绑定)、MITM(防中间人)、LE Secure Connections。本项目要求绑定、不强制 MITM/LESC，教学设备够用；配对后主机记住设备，之后重连自动完成。" style="text;html=1;fontSize=10;fontColor=#555555;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="624" width="390" height="62" as="geometry" />
        </mxCell>

        <!-- ===== L4 完整旅程 ===== -->
        <mxCell id="l4_hdr" value="⑧ 手势的完整旅程" style="rounded=1;arcSize=40;fillColor=#B5487E;strokeColor=#7E2C55;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#FFFFFF;html=1;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="470" y="817" width="190" height="46" as="geometry" />
        </mxCell>
        <mxCell id="e_l4c" style="edgeStyle=none;rounded=0;html=1;strokeWidth=2;strokeColor=#7E2C55;endArrow=none;startArrow=none;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="470" y="840" as="sourcePoint" />
            <mxPoint x="430" y="840" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="l4_card" value="" style="rounded=1;arcSize=8;fillColor=#FBF0F5;strokeColor=#E4A9C6;strokeWidth=1.5;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="745" width="390" height="190" as="geometry" />
        </mxCell>
        <mxCell id="l4_t" value="把①~⑦串起来：一次挥手发生了什么" style="text;html=1;fontSize=11;fontStyle=1;fontColor=#7E2C55;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="753" width="390" height="18" as="geometry" />
        </mxCell>
        <mxCell id="l4_c1" value="paj.readGesture()        // 读取手势" style="text;html=1;fontFamily=Courier New;fontSize=10;fontColor=#24292F;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="775" width="390" height="15" as="geometry" />
        </mxCell>
        <mxCell id="l4_c2" value=" → doGesture(g)          // 按模式查映射" style="text;html=1;fontFamily=Courier New;fontSize=10;fontColor=#24292F;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="791" width="390" height="15" as="geometry" />
        </mxCell>
        <mxCell id="l4_c3" value=" → sendKey(0x4B)         // 例: PageUp" style="text;html=1;fontFamily=Courier New;fontSize=10;fontColor=#24292F;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="807" width="390" height="15" as="geometry" />
        </mxCell>
        <mxCell id="l4_c4" value=" → setValue + notify()   // 无线推送" style="text;html=1;fontFamily=Courier New;fontSize=10;fontColor=#24292F;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="823" width="390" height="15" as="geometry" />
        </mxCell>
        <mxCell id="l4_c5" value=" → 主机执行动作" style="text;html=1;fontFamily=Courier New;fontSize=10;fontColor=#24292F;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="839" width="390" height="15" as="geometry" />
        </mxCell>
        <mxCell id="l4_n" value="例：Media 模式上滑 = repeatConsumer(0x00E9, 5) → 音量+ ×5；挥手 = 0x00E2 静音；手势冷却 GESTURE_COOLDOWN_MS = 250ms 防止同一动作重复触发。" style="text;html=1;fontSize=10;fontColor=#555555;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="857" width="390" height="62" as="geometry" />
        </mxCell>

        <!-- ===== 底部说明 ===== -->
        <mxCell id="mm_foot" value="代码摘自 src/main.cpp（NimBLE-Arduino 库）· 本图与电路图（circuit.drawio / circuit_internal.drawio）相互独立，可分开导出使用" style="text;html=1;fontSize=11;fontColor=#888888;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="955" width="1200" height="24" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
