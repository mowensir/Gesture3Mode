        <mxCell id="r3_c1" value="uint8_t r[8] = {mod, 0, key, 0,0,0,0,0};" style="text;html=1;fontFamily=Courier New;fontSize=10;fontColor=#24292F;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1">
